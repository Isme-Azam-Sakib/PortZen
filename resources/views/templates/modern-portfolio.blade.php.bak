}

.skill-edit-actions .cancel-skill {
    background: #f44336;
    color: white;
}

.add-skill-form {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: 10px;
}

.add-skill-input {
    padding: 8px;
